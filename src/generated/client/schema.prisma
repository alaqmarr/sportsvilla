generator client {
  provider   = "prisma-client-js"
  engineType = "library"
  output     = "../src/generated/client"
}

datasource db {
  provider = "sqlite"
}

model Admin {
  id          String     @id @default(cuid())
  email       String
  password    String
  name        String?
  role        String     @default("SUPERADMIN") // "SUPERADMIN" | "ADMIN"
  permissions String     @default("") // Comma-separated permission keys
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  auditLogs   AuditLog[]
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Member {
  id                      String                   @id @default(cuid())
  mobile                  String // Removed @unique to allow family accounts
  name                    String
  email                   String?
  dateOfBirth             DateTime?
  loyaltyPoints           Int                      @default(0)
  walletBalance           Float                    @default(0)
  joinDate                DateTime                 @default(now())
  memberships             MemberMembership[]
  attendances             Attendance[]
  bookings                Booking[]
  loyaltyHistory          LoyaltyHistory[]
  tournamentRegistrations TournamentRegistration[]
  walletTransactions      WalletTransaction[]
  couponAssignments       CouponAssignment[]
  couponUsages            CouponUsage[]
  loyaltyAchievements     LoyaltyAchievement[]
  sportStats              UserSportStat[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  @@index([mobile])
  @@index([updatedAt])
}

model LoyaltyHistory {
  id          String   @id @default(cuid())
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  points      Int
  type        String // "EARNED" | "REDEEMED"
  source      String // "BOOKING" | "CHECKIN" | "MEMBERSHIP" | "MANUAL"
  description String?
  createdAt   DateTime @default(now())

  @@index([memberId])
  @@index([createdAt])
}

model Sport {
  id                     String           @id @default(cuid())
  name                   String
  description            String?
  rewardPointsPerCheckin Int              @default(0)
  turfs                  TurfSport[]
  membershipPlans        MembershipPlan[]
  attendances            Attendance[]
  bookings               Booking[]
  tournaments            Tournament[]
  sportStats             UserSportStat[]
  banners                Banner[]
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  @@index([updatedAt])
}

model Turf {
  id                       String             @id @default(cuid())
  name                     String
  location                 String?
  parentTurfId             String?
  parentTurf               Turf?              @relation("TurfHierarchy", fields: [parentTurfId], references: [id])
  childTurfs               Turf[]             @relation("TurfHierarchy")
  sports                   TurfSport[]
  bookingPrice             Float? // Price per booking duration
  bookingDurationMinutes   Int? // Duration of a single booking slot in minutes
  capacityPerSlot          Int                @default(1) // Number of bookings allowed per slot
  requireEntryVerification Boolean            @default(false) // Uncapped bookings
  bookingValidityDays      Int                @default(0) // Extra days valid
  bookings                 Booking[]
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  memberMemberships        MemberMembership[]

  @@index([updatedAt])
}

model TurfSport {
  turfId  String
  sportId String
  turf    Turf   @relation(fields: [turfId], references: [id], onDelete: Cascade)
  sport   Sport  @relation(fields: [sportId], references: [id], onDelete: Cascade)

  @@id([turfId, sportId])
}

model MembershipPlan {
  id                     String             @id @default(cuid())
  name                   String
  sportId                String
  sport                  Sport              @relation(fields: [sportId], references: [id], onDelete: Cascade)
  durationInDays         Int
  price                  Float
  slotsPerDay            Int                @default(1)
  isFamilyPlan           Boolean            @default(false)
  familySize             Int?
  rewardPointsOnPurchase Int                @default(0)
  rewardPointsPerCheckin Int                @default(0)
  memberships            MemberMembership[]
  attendances            Attendance[]
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
}

model MemberMembership {
  id               String         @id @default(cuid())
  memberId         String
  member           Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  membershipPlanId String
  membershipPlan   MembershipPlan @relation(fields: [membershipPlanId], references: [id], onDelete: Cascade)
  startDate        DateTime
  endDate          DateTime
  status           String         @default("ACTIVE") // ACTIVE, EXPIRED, CANCELLED

  turfId      String?
  turf        Turf?   @relation(fields: [turfId], references: [id], onDelete: Cascade)
  timeSlot    String?
  allowedDays String? // Comma-separated day indices, e.g. "0,6" for Sun,Sat

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([endDate])
  @@index([status])
}

model Attendance {
  id               String          @id @default(cuid())
  memberId         String
  member           Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  date             DateTime        @default(now())
  status           String          @default("PRESENT")
  sportId          String? // Optional: what sport they played
  sport            Sport?          @relation(fields: [sportId], references: [id], onDelete: Cascade)
  membershipPlanId String?
  membershipPlan   MembershipPlan? @relation(fields: [membershipPlanId], references: [id], onDelete: Cascade)
  notes            String?
  createdAt        DateTime        @default(now())

  @@index([date])
  @@index([memberId, date])
  @@index([createdAt])
}

model Booking {
  id               String        @id @default(cuid())
  turfId           String
  turf             Turf          @relation(fields: [turfId], references: [id], onDelete: Cascade)
  memberId         String
  member           Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  sportId          String
  sport            Sport         @relation(fields: [sportId], references: [id], onDelete: Cascade)
  startTime        DateTime
  endTime          DateTime
  price            Float
  paymentStatus    String        @default("PENDING") // UNPAID, PARTIAL, PAID
  status           String        @default("CONFIRMED") // CONFIRMED, CANCELLED
  participantCount Int           @default(1)
  pointsRedeemed   Int           @default(0)
  discountAmount   Float         @default(0)
  advancePaid      Float         @default(0)
  amountDue        Float         @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  payments         Payment[]
  tickets          Ticket[]
  couponUsages     CouponUsage[]

  @@index([startTime])
  @@index([turfId])
  @@index([memberId])
  @@index([updatedAt])
  @@index([status])
}

model Payment {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount    Float
  method    String // CASH, ONLINE
  createdAt DateTime @default(now())

  @@index([bookingId])
  @@index([createdAt])
}

model DisplaySession {
  id         String   @id
  bookingId  String?
  qrData     String?
  amount     Float?
  memberName String?
  status     String   @default("IDLE") // IDLE, AWAITING_PAYMENT, PAID
  updatedAt  DateTime @updatedAt
}

model Ticket {
  id        String    @id @default(cuid())
  bookingId String
  booking   Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  qrCode    String    @unique
  guestName String?
  status    String    @default("VALID") // VALID, CHECKED_IN, CANCELLED
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([qrCode])
  @@index([bookingId])
}

model Otp {
  id          String    @id @default(cuid())
  mobile      String    @unique
  code        String
  expiresAt   DateTime
  attempts    Int       @default(0)
  lockedUntil DateTime?
  createdAt   DateTime  @default(now())
}

model Tournament {
  id               String    @id @default(cuid())
  name             String
  description      String?
  participationFee Float     @default(0)
  teamSize         Int       @default(1)
  maxTeams         Int?
  thumbnail        String?
  rules            String?
  status           String    @default("UPCOMING") // UPCOMING, ONGOING, COMPLETED
  startDate        DateTime
  endDate          DateTime?

  // New fields for UI/UX refinement
  isPublic             Boolean   @default(true)
  prizePool            String?
  venue                String?
  registrationDeadline DateTime?
  sportId              String?
  sport                Sport?    @relation(fields: [sportId], references: [id])
  paymentUpiId         String?

  // New Payment Fields
  acceptsCash           Boolean @default(false)
  cashResponsiblePerson String?

  registrations TournamentRegistration[]
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
}

model TournamentRegistration {
  id                   String             @id @default(cuid())
  tournamentId         String
  tournament           Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teamName             String?
  paymentMethod        String             @default("UPI") // UPI, CASH
  paymentScreenshotUrl String?
  paymentUtr           String?
  status               String             @default("PENDING") // PENDING, VERIFIED, REJECTED
  registeredById       String
  registeredBy         Member             @relation(fields: [registeredById], references: [id], onDelete: Cascade)
  players              TournamentPlayer[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([tournamentId])
  @@index([registeredById])
}

model TournamentPlayer {
  id             String                 @id @default(cuid())
  registrationId String
  registration   TournamentRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  name           String
  mobile         String?
  memberId       String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([registrationId])
}

model WalletTransaction {
  id          String   @id @default(cuid())
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  amount      Float
  type        String // "CREDIT" or "DEBIT"
  description String?
  createdAt   DateTime @default(now())

  @@index([memberId])
  @@index([createdAt])
}

model Coupon {
  id                 String    @id @default(cuid())
  code               String    @unique
  discountAmount     Float?
  discountPercentage Float?
  maxDiscount        Float?
  maxUses            Int?
  maxUsesPerUser     Int?
  isActive           Boolean   @default(true)
  expiryDate         DateTime?

  appOnly  Boolean @default(false)
  isPublic Boolean @default(true)

  targetType             String   @default("EVERYONE") // EVERYONE, SPECIFIC_MEMBERS, MILESTONE_ALL_TIME, MILESTONE_FROM_CREATION
  milestoneBookingsCount Int?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  usages      CouponUsage[]
  assignments CouponAssignment[]
}

model CouponAssignment {
  id        String   @id @default(cuid())
  couponId  String
  memberId  String
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([couponId, memberId])
}

model CouponUsage {
  id             String   @id @default(cuid())
  couponId       String
  memberId       String
  bookingId      String
  discountAmount Float    @default(0)
  createdAt      DateTime @default(now())

  coupon  Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  member  Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model LoyaltyTrigger {
  id                  String  @id @default(cuid())
  title               String // e.g. "Weekend Warrior"
  description         String? // e.g. "Play 5 matches and get ₹100!"
  targetBookingsCount Int
  rewardAmount        Float // Wallet cash reward
  rewardPoints        Int     @default(0) // SV Points reward
  isActive            Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  achievements LoyaltyAchievement[]
}

model LoyaltyAchievement {
  id         String   @id @default(cuid())
  triggerId  String
  memberId   String
  achievedAt DateTime @default(now())

  trigger LoyaltyTrigger @relation(fields: [triggerId], references: [id], onDelete: Cascade)
  member  Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([triggerId, memberId])
}

model AppAnnouncement {
  id        String   @id @default(cuid())
  title     String
  content   String
  imageUrl  String?
  linkUrl   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AppVersion {
  id           String   @id @default(cuid())
  platform     String   @unique // "android" or "ios"
  version      String // e.g. "1.0.1"
  forceUpdate  Boolean  @default(true)
  downloadUrl  String?
  fileKey      String?
  releaseNotes String?
  updatedAt    DateTime @updatedAt
}

// Single-row table bumped on every create/update/delete for efficient sync polling
model LastUpdate {
  id        String   @id @default("singleton")
  timestamp DateTime @default(now())
  source    String   @default("init") // which table triggered the update
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String // e.g. "CREATE_BOOKING", "CANCEL_BOOKING"
  entity    String // e.g. "Booking", "Member"
  entityId  String
  details   String? // JSON string
  adminName String   @default("System")
  adminId   String? // Relation to Admin who performed the action
  admin     Admin?   @relation(fields: [adminId], references: [id])
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

model Banner {
  id            String   @id @default(cuid())
  imageUrl      String
  title         String?
  targetSportId String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  targetSport Sport? @relation(fields: [targetSportId], references: [id], onDelete: SetNull)
}

model UserSportStat {
  id           String   @id @default(cuid())
  memberId     String
  sportId      String
  bookingCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  sport  Sport  @relation(fields: [sportId], references: [id], onDelete: Cascade)

  @@unique([memberId, sportId])
}
