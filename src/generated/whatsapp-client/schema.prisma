generator client {
  provider   = "prisma-client-js"
  engineType = "library"
  output     = "../src/generated/whatsapp-client"
}

datasource db {
  provider = "sqlite"
}

model WhatsAppMessage {
  id           String   @id @default(cuid())
  wamid        String?  @unique // Meta WhatsApp Message ID (e.g. wamid.XXX)
  phoneNumber  String // Recipient or sender phone number (e.g. 919876543210)
  direction    String // "OUTGOING" or "INCOMING"
  type         String // "TEXT", "TEMPLATE", "OTP", "IMAGE", "INTERACTIVE"
  content      String // Text body or JSON string of template/message payload
  status       String // "PENDING", "SENT", "DELIVERED", "READ", "FAILED", "RECEIVED"
  errorCode    String? // Meta error code if status is FAILED
  errorMessage String? // Detailed error explanation
  metadata     String? // Optional extra metadata as JSON string
  isOptOut     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([phoneNumber])
  @@index([status])
  @@index([createdAt])
}

model WhatsAppOtp {
  id          String   @id @default(cuid())
  phoneNumber String // Recipient phone number (e.g. 919876543210)
  otp         String // 6-digit OTP code
  purpose     String // "LOGIN", "REGISTER", "VERIFY"
  verified    Boolean  @default(false)
  expiresAt   DateTime // Timestamp when OTP expires
  createdAt   DateTime @default(now())

  @@index([phoneNumber, purpose])
  @@index([createdAt])
}

model WhatsAppWebhookLog {
  id        String   @id @default(cuid())
  event     String // e.g. "messages", "statuses", "verification"
  payload   String // Full JSON string of the incoming Meta webhook payload
  processed Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([event])
  @@index([createdAt])
}

model WhatsAppConfig {
  key       String   @id // e.g. "AUTO_REPLY_ENABLED", "AUTO_REPLY_MESSAGE", "AUTO_REPLY_COOLDOWN_MINUTES"
  value     String // e.g. "true" or custom message text
  updatedAt DateTime @updatedAt
}

model WhatsAppConversation {
  id              String   @id @default(cuid()) // Our internal ID
  wacId           String   @unique // WhatsApp Conversation ID from pricing webhook
  recipientMobile String
  category        String // "marketing", "utility", "authentication", "service", "referral_conversion"
  isFreeTier      Boolean  @default(false)
  openedAt        DateTime
  expiresAt       DateTime // openedAt + 24 hours
  cost            Float    @default(0)
  createdAt       DateTime @default(now())

  @@index([category])
  @@index([expiresAt])
}

model WhatsAppAccountMetric {
  id             String   @id @default("singleton")
  phoneNumberId  String?
  qualityRating  String   @default("GREEN") // "GREEN", "YELLOW", "RED"
  messagingLimit String   @default("UNKNOWN") // "250", "1K", "10K", "100K", "UNLIMITED"
  updatedAt      DateTime @updatedAt
}

model WhatsAppTemplate {
  id             String   @id @default(cuid())
  name           String   @unique
  category       String   @default("MARKETING")
  language       String   @default("en")
  status         String // "APPROVED", "PAUSED", "REJECTED", "PENDING"
  headerImageUrl String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
}

model WhatsAppEventTrigger {
  id           String   @id @default(cuid())
  eventName    String   @unique // e.g. "BOOKING_CONFIRMED", "PAYMENT_RECEIVED", "MEMBERSHIP_EXPIRED"
  templateName String? // Meta template name to use
  isActive     Boolean  @default(false)
  variableMap  String? // JSON string: e.g. {"1": "bookingId", "2": "turfName"}
  updatedAt    DateTime @updatedAt
}
