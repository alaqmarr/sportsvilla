generator client {
  provider   = "prisma-client-js"
  engineType = "library"
  output     = "../src/generated/client"
}

datasource db {
  provider = "sqlite"
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Member {
  id             String             @id @default(cuid())
  mobile         String // Removed @unique to allow family accounts
  name           String
  email          String?
  dateOfBirth    DateTime?
  loyaltyPoints  Int                @default(0)
  walletBalance  Float              @default(0)
  joinDate              DateTime                 @default(now())
  memberships           MemberMembership[]
  attendances           Attendance[]
  bookings              Booking[]
  loyaltyHistory        LoyaltyHistory[]
  tournamentRegistrations TournamentRegistration[]
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  @@index([mobile])
}

model LoyaltyHistory {
  id          String   @id @default(cuid())
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id])
  points      Int
  type        String // "EARNED" | "REDEEMED"
  source      String // "BOOKING" | "CHECKIN" | "MEMBERSHIP" | "MANUAL"
  description String?
  createdAt   DateTime @default(now())

  @@index([memberId])
}

model Sport {
  id                     String           @id @default(cuid())
  name                   String
  description            String?
  rewardPointsPerCheckin Int              @default(0)
  turfs                  TurfSport[]
  membershipPlans        MembershipPlan[]
  attendances            Attendance[]
  bookings               Booking[]
  tournaments            Tournament[]
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
}

model Turf {
  id                       String      @id @default(cuid())
  name                     String
  location                 String?
  parentTurfId             String?
  parentTurf               Turf?       @relation("TurfHierarchy", fields: [parentTurfId], references: [id])
  childTurfs               Turf[]      @relation("TurfHierarchy")
  sports                   TurfSport[]
  bookingPrice             Float? // Price per booking duration
  bookingDurationMinutes   Int? // Duration of a single booking slot in minutes
  capacityPerSlot          Int         @default(1) // Number of bookings allowed per slot
  requireEntryVerification Boolean     @default(false) // Uncapped bookings
  bookingValidityDays      Int         @default(0) // Extra days valid
  bookings                 Booking[]
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt
}

model TurfSport {
  turfId  String
  sportId String
  turf    Turf   @relation(fields: [turfId], references: [id])
  sport   Sport  @relation(fields: [sportId], references: [id])

  @@id([turfId, sportId])
}

model MembershipPlan {
  id                     String             @id @default(cuid())
  name                   String
  sportId                String
  sport                  Sport              @relation(fields: [sportId], references: [id])
  durationInDays         Int
  price                  Float
  slotsPerDay            Int                @default(1)
  isFamilyPlan           Boolean            @default(false)
  familySize             Int?
  rewardPointsOnPurchase Int                @default(0)
  rewardPointsPerCheckin Int                @default(0)
  memberships            MemberMembership[]
  attendances            Attendance[]
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
}

model MemberMembership {
  id               String         @id @default(cuid())
  memberId         String
  member           Member         @relation(fields: [memberId], references: [id])
  membershipPlanId String
  membershipPlan   MembershipPlan @relation(fields: [membershipPlanId], references: [id])
  startDate        DateTime
  endDate          DateTime
  status           String         @default("ACTIVE") // ACTIVE, EXPIRED, CANCELLED
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([endDate])
  @@index([status])
}

model Attendance {
  id               String          @id @default(cuid())
  memberId         String
  member           Member          @relation(fields: [memberId], references: [id])
  date             DateTime        @default(now())
  status           String          @default("PRESENT")
  sportId          String? // Optional: what sport they played
  sport            Sport?          @relation(fields: [sportId], references: [id])
  membershipPlanId String?
  membershipPlan   MembershipPlan? @relation(fields: [membershipPlanId], references: [id])
  notes            String?
  createdAt        DateTime        @default(now())

  @@index([date])
}

model Booking {
  id               String    @id @default(cuid())
  turfId           String
  turf             Turf      @relation(fields: [turfId], references: [id])
  memberId         String
  member           Member    @relation(fields: [memberId], references: [id])
  sportId          String
  sport            Sport     @relation(fields: [sportId], references: [id])
  startTime        DateTime
  endTime          DateTime
  price            Float
  paymentStatus    String    @default("PENDING") // UNPAID, PARTIAL, PAID
  status           String    @default("CONFIRMED") // CONFIRMED, CANCELLED
  participantCount Int       @default(1)
  pointsRedeemed   Int       @default(0)
  discountAmount   Float     @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  payments         Payment[]
  tickets          Ticket[]

  @@index([startTime])
  @@index([turfId])
}

model Payment {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id])
  amount    Float
  method    String // CASH, ONLINE
  createdAt DateTime @default(now())

  @@index([bookingId])
}

model DisplaySession {
  id         String   @id
  bookingId  String?
  qrData     String?
  amount     Float?
  memberName String?
  status     String   @default("IDLE") // IDLE, AWAITING_PAYMENT, PAID
  updatedAt  DateTime @updatedAt
}

model Ticket {
  id        String    @id @default(cuid())
  bookingId String
  booking   Booking   @relation(fields: [bookingId], references: [id])
  qrCode    String    @unique
  guestName String?
  status    String    @default("VALID") // VALID, CHECKED_IN, CANCELLED
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([qrCode])
  @@index([bookingId])
}

model Otp {
  id        String   @id @default(cuid())
  mobile    String   @unique
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Tournament {
  id                   String                   @id @default(cuid())
  name                 String
  description          String?
  participationFee     Float                    @default(0)
  teamSize             Int                      @default(1)
  maxTeams             Int?
  thumbnail            String?
  rules                String?
  status               String                   @default("UPCOMING") // UPCOMING, ONGOING, COMPLETED
  startDate            DateTime
  endDate              DateTime?
  
  // New fields for UI/UX refinement
  isPublic             Boolean                  @default(true)
  prizePool            String?
  venue                String?
  registrationDeadline DateTime?
  sportId              String?
  sport                Sport?                   @relation(fields: [sportId], references: [id])
  paymentUpiId         String?
  
  // New Payment Fields
  acceptsCash           Boolean                 @default(false)
  cashResponsiblePerson String?

  registrations        TournamentRegistration[]
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
}

model TournamentRegistration {
  id                   String             @id @default(cuid())
  tournamentId         String
  tournament           Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teamName             String?
  paymentMethod        String             @default("UPI") // UPI, CASH
  paymentScreenshotUrl String?
  paymentUtr           String?
  status               String             @default("PENDING") // PENDING, VERIFIED, REJECTED
  registeredById       String
  registeredBy         Member             @relation(fields: [registeredById], references: [id])
  players              TournamentPlayer[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([tournamentId])
  @@index([registeredById])
}

model TournamentPlayer {
  id             String                 @id @default(cuid())
  registrationId String
  registration   TournamentRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  name           String
  mobile         String?
  memberId       String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([registrationId])
}
