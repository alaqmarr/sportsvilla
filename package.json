    "@prisma/client": "^7.8.0",
    "@yudiel/react-qr-scanner": "^2.6.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.10.0",
    "date-fns": "^4.3.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.4.2",
    "firebase-admin": "^14.2.0",
    "html2canvas": "^1.4.1",
    "html5-qrcode": "^2.3.8",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "jsqr": "^1.4.0",
    "next": "16.2.6",
    "next-auth": "^4.24.14",
