{
  "name": "sportsvilla",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "npx prisma generate && npx prisma db push",
    "updatebeta": "git stash && git pull && npm i --legacy-peer-deps && npm run build && pm2 restart sportsvilla",
    "updateprod": "git stash && git pull && npm i --legacy-peer-deps && npm run build && pm2 restart sportsvilla-production"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1090.0",
